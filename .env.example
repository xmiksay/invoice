# --- Runtime (invoice serve / invoice migrate) --------------------------------
# PostgreSQL connection string (required).
INVOICE__DATABASE_URL=postgres://invoice:invoice@localhost:5433/invoice
# Static Bearer token for the API and SPA login (required, non-empty).
# Generate one with: openssl rand -hex 32
INVOICE__API_TOKEN=change-me
# Listen address (optional, default 0.0.0.0:3000).
INVOICE__BIND=0.0.0.0:3000
# Log filter (optional, default invoice=info,tower_http=info,sea_orm_migration=info).
RUST_LOG=invoice=info,tower_http=info,sea_orm_migration=info

# --- Tests -------------------------------------------------------------------
# Postgres used by the integration tests (each test gets a throwaway schema).
# Required by `cargo test --test '*'`; when unset, the Makefile derives it from
# TEST_DB_PORT (default 5433, the docker-compose host port).
TEST_DATABASE_URL=postgres://invoice:invoice@localhost:5433/invoice
